<Project Sdk="Microsoft.NET.Sdk">
	<metadata>
		<id>AudibleApi</id>
		<version>0.0.0</version>
		<description>Audible API in C# </description>
		<authors>rmcrackan</authors>
		<repository type="git" url="https://github.com/rmcrackan/AudibleApi.git" branch="master" />
		<projectUrl>https://github.com/rmcrackan/AudibleApi</projectUrl>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
		<Tags>Audible AAC AAXC m4b audiobook</Tags>
        <language>en-US</language>
		<readme>docs\README.md</readme>	
		<license type="file">lic</license>
		<!-- Hand-maintained: this file is what gets packed, not the csproj, so bumping a PackageReference
		     does not change what the published package says it needs. Keep this in step with
		     AudibleApi.Common's Dinah.Core reference. 10.2.2 is the floor for Dinah.Core.Security.SecretString,
		     which the token types now hold their values in. -->
		<dependencies>
			<group targetFramework="net10.0">
				<dependency id="Dinah.Core" version="10.2.4.1" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="AudibleApi\bin\Release\net10.0\AudibleApi.dll" target="lib\net10.0\" />
		<file src="AudibleApi\bin\Release\net10.0\AudibleApi.Common.dll" target="lib\net10.0\" />
		
		<file src="README.md" target="docs\" />
		<file src="LICENSE" target="lic" />
	</files>
</Project>
